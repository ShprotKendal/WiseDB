# Dev image: editable install + uvicorn --reload (see docker-compose.dev.yml bind mounts).
# Rebuild after C/Cython or dependency changes: docker compose -f docker-compose.dev.yml build
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml setup.py MANIFEST.in README.md ./
COPY include ./include
COPY src ./src

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10
RUN set -eux; \
    for attempt in 1 2 3; do \
      pip install --no-cache-dir -e ".[server,dev]" && break; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      echo "pip install failed (attempt ${attempt}), retrying..."; \
      sleep 5; \
    done

ENV WISEDB_DATA_DIR=/app/data \
    WISEDB_HOST=0.0.0.0 \
    WISEDB_PORT=8000

EXPOSE 8000

# Only watch mounted Python trees (compose bind-mounts); Cython extension stays from the image build.
CMD ["uvicorn", "wisedb.server.app:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app/src/wisedb/server", \
     "--reload-dir", "/app/src/wisedb/wql", \
     "--reload-dir", "/app/src/wisedb"]
